# Backend configuration (environment variables). On Render these are set in the dashboard / render.yaml;
# locally you can export them before running uvicorn. Never commit a real .env file.

# --- Core ---------------------------------------------------------------------------------
# "production" stops localhost origins being allowed by CORS.
QUESTVERSE_ENV=development
# Allowed frontend origin(s), comma separated, no trailing slash. "*" is not accepted.
FRONTEND_URL=http://localhost:5173
# SQLite file. Default: backend/questverse.db. On Render point it at the persistent disk.
# QUESTVERSE_DB=/var/data/questverse.db
# PORT is provided by Render; defaults to 10000 in the Docker image.
# PORT=10000

# --- Optional: AI hints and PDF quizzes (needs a separately hosted Ollama server) -----------
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_TIMEOUT_S=8
# QUESTVERSE_NO_WARMUP=1            # skip loading the model into memory at start-up

# --- Optional: weekly report emails (set HOST and FROM to switch them on) -------------------
# QUESTVERSE_SMTP_HOST=smtp.example.com
# QUESTVERSE_SMTP_PORT=587
# QUESTVERSE_SMTP_USER=
# QUESTVERSE_SMTP_PASSWORD=
# QUESTVERSE_SMTP_FROM=QuestVerse <noreply@example.com>
# QUESTVERSE_NO_SCHEDULER=1         # don't run the weekly report job
