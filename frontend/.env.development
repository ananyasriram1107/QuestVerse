# QuestVerse backend for `npm run dev`.
# Port 8000 is often taken by other local APIs, which makes the map fail to load,
# so QuestVerse uses 8010:  uvicorn main:app --port 8010   (run from backend/)
# Prefer 8000? Delete this file, or put VITE_API_BASE_URL in frontend/.env.local.
VITE_API_BASE_URL=http://127.0.0.1:8010
