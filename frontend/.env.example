# Copy to .env.local for local overrides, or set in Vercel -> Project -> Settings -> Environment Variables.
# Anything starting with VITE_ is compiled into the public JavaScript bundle: never put a secret here.

# Public URL of the QuestVerse API, no trailing slash.
#   local:       http://127.0.0.1:8010
#   production:  https://questverse-api.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8010
